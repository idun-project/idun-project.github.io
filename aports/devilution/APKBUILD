# Maintainer: Brian Holdsworth <brian@focus42llc.com>
pkgname=devilutionx
pkgver=1.5.5
pkgrel=0
pkgdesc="Diablo devolved for Linux"
url="https://github.com/diasurgical/devilutionX"
arch="aarch64"
license="Unlicense"
depends="sdl3 sdl2-compat sdl2_image simpleini"
makedepends="
	bzip2-dev
	cmake
	flac-dev
	fmt-dev
	gettext-dev
	lame-dev
	libpng-dev
	libsodium-dev
	samurai
	sdl2-compat-dev
	sdl2_image-dev
	zlib-dev
"
subpackages="$pkgname-fonts $pkgname-voices"
builddir="$srcdir/$pkgname-src-$pkgver"

source="
	https://github.com/diasurgical/devilutionX/releases/download/$pkgver/devilutionx-src.tar.xz
	https://github.com/diasurgical/devilutionX-assets/releases/download/v4/fonts.mpq
	https://github.com/diasurgical/devilutionX-assets/releases/download/v4/pl.mpq
	https://github.com/diasurgical/devilutionX-assets/releases/download/v4/ru.mpq
"

build() {
	export CXXFLAGS="$CXXFLAGS -DFMT_DEPRECATED_HEAVY_CORE=1"
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DBUILD_TESTING=OFF \
		-DCPACK=ON
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

fonts() {
	pkgdesc="Additional fonts for DevilutionX"
	depends="$pkgname"

	install -Dm644 "$srcdir"/fonts.mpq \
		"$subpkgdir"/usr/share/diasurgical/devilutionx/fonts.mpq
}

voices() {
	pkgdesc="Additional voices for DevilutionX"
	depends="$pkgname"

	install -Dm644 "$srcdir"/pl.mpq \
		"$subpkgdir"/usr/share/diasurgical/devilutionx/pl.mpq
	install -Dm644 "$srcdir"/ru.mpq \
		"$subpkgdir"/usr/share/diasurgical/devilutionx/ru.mpq
}
