 pub use termion::clear::CurrentLine as ClearCurrentLine;
 pub use termion::clear::UntilNewline as ClearUntilNewline;
 
+/// CSI sequence: set the vertical scrolling region (DECSTBM) to the
+/// 1-based, inclusive row range `top..=bottom`. While a region is set,
+/// scroll-up/scroll-down and line feeds at the margins only shift the
+/// rows inside it, leaving everything else (such as a status bar on the
+/// last row) untouched. This is what lets us scroll without repainting
+/// the whole screen -- the expensive operation on a remote/retro
+/// terminal, where each cell may be an 8x8 bitmap blit.
+pub fn set_scroll_region(top: u16, bottom: u16) -> String {
+    format!("\x1b[{};{}r", top, bottom)
+}
+
+/// CSI sequence: reset the scrolling region back to the full screen.
+pub fn reset_scroll_region() -> &'static str {
+    "\x1b[r"
+}
+
+/// CSI sequence: scroll the contents of the current scrolling region
+/// up by `n` lines, revealing `n` blank lines at the bottom. (SU)
+pub fn scroll_up(n: u16) -> String {
+    format!("\x1b[{}S", n)
+}
+
+/// CSI sequence: scroll the contents of the current scrolling region
+/// down by `n` lines, revealing `n` blank lines at the top. (SD)
+pub fn scroll_down(n: u16) -> String {
+    format!("\x1b[{}T", n)
+}
+
 type Result<T> = std::result::Result<T, io::Error>;
 
