#Maintainer: Brian Holdsworth <brian@focus42llc.com>

pkgname=phetch
pkgver=1.2.0
pkgrel=0
pkgdesc="A quick lil gopher client for your terminal."
url="https://github.com/xvxx/phetch"
makedepends="openssl-libs-static openssl-dev"
arch="aarch64"
license="MIT"
subpackages="$pkgname-doc"
source="
  $pkgname-$pkgver.tar.gz::https://static.crates.io/crates/$pkgname/$pkgname-$pkgver.crate
  incremental-scroll.patch
"

build() {
  cd "$builddir"
  cargo build --locked --release
}

check() {
  cd "$builddir"
  cargo test	
}

package() {
  cd "$builddir"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "doc/$pkgname.1" "$pkgdir/usr/share/man/man1/$pkgname.1"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
sha512sums="
899199fd75e578dca2f724cafbafe23510064e4b8dd12d5b6d986f701b4fad42cc63160be80d2ab23cfe8be2ca874500f641278b41046e6ca9ad05bc15f308e7  phetch-1.2.0.tar.gz
7585fbf4a9829d722d6580edccbae7fe40b99e935f08c3f2283c3cc99a08f2cf37e8bf1d0a84d70bfdf1fb39ac4b54e8960d27eb67dedd5d72771f82e59f067e  incremental-scroll.patch
"
