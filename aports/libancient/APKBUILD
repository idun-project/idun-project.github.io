# Maintainer: Brian Holdsworth <brian@focus42llc.com>

pkgname="libancient"
pkgver=2.3.0
pkgrel=0
pkgdesc="Decompression routines for ancient formats"
arch="aarch64"
url="https://github.com/temisu/ancient/"
license="BSD-2-Clause"
makedepends="libtool autoconf automake pkgconf autoconf-archive"
source="$pkgname-$pkgver.tar.gz::https://github.com/temisu/ancient/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/ancient-$pkgver"
options="!check"

prepare() {
        default_prepare
        ./autogen.sh
        ./configure --prefix=/usr CXXFLAGS="$CXXFLAGS -DANCIENT_API_VISIBILITY_DEFAULT -std=c++17"
}

build() {
        make
}

package() {
        make DESTDIR="$pkgdir" install
}
