# Maintainer: Brian Holdsworth <brian@focus42llc.com>

pkgname=ueberzugpp
pkgver=2.9.8
pkgrel=0
pkgdesc="Command line utility which allows to display images in the terminal, written in C++"
arch="aarch64"
url="https://github.com/jstkdng/ueberzugpp"
license="GPL-3.0-or-later"
provides="ueberzug"
subpackages="$pkgname-doc"
makedepends="cmake samurai extra-cmake-modules wayland-dev wayland-protocols
vips-dev libsixel-dev chafa-dev onetbb-dev openssl-dev"
depends="vips libsixel chafa wayland onetbb"
source="${pkgname}-${pkgver}.tar.gz::https://github.com/jstkdng/${pkgname}/archive/v${pkgver}.tar.gz"
options="!check"

build() {
  cmake -B build \
    -DCMAKE_BUILD_TYPE='Release' \
    -DCMAKE_INSTALL_PREFIX='/usr' \
    -DENABLE_WAYLAND=ON \
    -DENABLE_X11=OFF \
    -DENABLE_OPENCV=OFF \
    -Wno-dev
  cmake --build build -j "$(nproc)"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
sha512sums="
