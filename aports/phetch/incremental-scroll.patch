+    /// Render a single document line for display: optional left margin,
+    /// the line text (carriage returns stripped, tabs expanded), and a
+    /// clear-to-end-of-line. `None` (past the end of the document) or
+    /// Gopher's "." terminator yields a blank, cleared line.
+    fn render_text_line(&self, line: Option<&str>, indent: &str) -> String {
+        let mut out = String::new();
+        match line {
+            Some(line) if line != ".\r" && line != "." => {
+                if !self.wide {
+                    out.push_str(indent);
+                }
+                let line = line.trim_end_matches('\r').replace('\t', "    ");
+                out.push_str(&line);
+            }
+            _ => {}
+        }
+        out.push_str(terminal::ClearUntilNewline.as_ref());
+        out
+    }
+
+    /// Build an incremental scroll update. Rather than repainting the
+    /// whole screen on every scroll -- painfully slow on a remote or
+    /// retro VT100 emulator -- shift the body with a VT100 scrolling
+    /// region and only draw the line(s) the scroll exposed. Falls back
+    /// to a full `Redraw` when there is no overlap to reuse (a jump or a
+    /// full page) or the screen is too small to bother.
+    fn scrolled_redraw(&self, old_offset: usize) -> Action {
+        let (_cols, rows) = self.size;
+        let body = rows.saturating_sub(1); // last row is the status bar
+        let delta = self.offset as isize - old_offset as isize;
+        let n = delta.unsigned_abs();
+        if body < 2 || n == 0 || n >= body {
+            return Action::Redraw;
+        }
+
+        let wrap = self.config.read().unwrap().wrap;
+        let indent = self.indent_str(wrap);
+        let lines = wrap_text(&self.encoded_response, wrap);
+
+        let mut out = String::new();
+        out.push_str(&terminal::set_scroll_region(1, body as u16));
+        let (first_row, first_doc) = if delta > 0 {
+            // scrolled forward: body moves up, new lines appear at the bottom
+            out.push_str(&terminal::scroll_up(n as u16));
+            (body - n + 1, self.offset + body - n)
+        } else {
+            // scrolled back: body moves down, new lines appear at the top
+            out.push_str(&terminal::scroll_down(n as u16));
+            (1, self.offset)
+        };
+        for i in 0..n {
+            out.push_str(&format!("{}", terminal::Goto(1, (first_row + i) as u16)));
+            out.push_str(
+                &self.render_text_line(lines.get(first_doc + i).copied(), indent.as_ref()),
+            );
+        }
+        out.push_str(terminal::reset_scroll_region());
+        Action::Draw(out)
+    }
 }
 
