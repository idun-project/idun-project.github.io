# Contributor: Leo V <leo-v.email@proton.me>
# Maintainer: Brian Holdsworth <brian@focus42llc.com>
pkgname=hypseus-singe
pkgver=3.0.1
pkgrel=0
pkgdesc="Arcade Laserdisc Emulator SDL3 version of Daphne and Singe"
url="https://github.com/DirtBagXon/hypseus-singe"
arch="aarch64"
license="GPL-3.0-or-later"
depends="sdl3 sdl3_ttf sdl3_mixer sdl3_image"
makedepends="cmake sdl3-dev sdl3_ttf-dev sdl3_mixer sdl3_image-dev libzip-dev libvorbis-dev zlib-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/DirtBagXon/hypseus-singe/archive/refs/tags/v$pkgver.tar.gz
	musl-ctime.patch
	mpeg2-cmake.patch"
builddir="$srcdir/$pkgname-$pkgver"
options="!check"

build() {
    mkdir -p "$builddir/build"
	cd "$builddir/build"

	cmake -G "Unix Makefiles" -DCMAKE_BUILD_TYPE="Release" \
		-DCMAKE_INSTALL_PREFIX="/usr/share" \
		-DCMAKE_PREFIX_PATH="/usr/share" \
		-DCMAKE_C_FLAGS="-O3" \
		-DCMAKE_CXX_FLAGS="-O3" \
		-DLIBMPEG2_CFLAGS="-std=gnu89 -O3 -mcpu=cortex-a53" \
		../src

	make -j4
}

package() {
	local datadir="$pkgdir/usr/share/$pkgname"
	cd "$builddir"
	
	install -Dm755 scripts/run.sh "$pkgdir"/usr/bin/hypseus
	install -Dm755 scripts/singe.sh "$pkgdir"/usr/bin/singe
	install -Dm755 build/hypseus "$pkgdir"/usr/bin/hypseus.bin
	install -d "$datadir"/pics/obsolete \
	           "$datadir"/sound \
	           "$datadir"/fonts \
	           "$datadir"/roms/cputest \
	           "$datadir"/screenshots
	install -m644 pics/*.* "$datadir"/pics/
	install -m644 roms/cputest/* "$datadir"/roms/cputest/
	install -m644 sound/* "$datadir"/sound/
	install -m644 fonts/* "$datadir"/fonts/
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -d "$pkgdir"/usr/share/doc/$pkgname/
	install -m644 doc/*.* "$pkgdir"/usr/share/doc/$pkgname/
}
