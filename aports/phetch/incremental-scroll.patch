+    /// Build an incremental scroll update for a small (typically
+    /// arrow-key) scroll. Instead of repainting the whole menu -- slow
+    /// over a remote/retro VT100 link, where redrawing every cell can
+    /// mean an 8x8 bitmap blit -- shift the body with a VT100 scrolling
+    /// region and only redraw the newly exposed line(s), then fix up the
+    /// selection cursor. Falls back to a full `Redraw` when there is no
+    /// overlap to reuse (a jump or a page) or the screen is tiny.
+    fn scrolled_redraw(&self, old_offset: usize, old_link: usize) -> Action {
+        let body = self.rows().saturating_sub(1); // last row is the status bar
+        let delta = self.offset as isize - old_offset as isize;
+        let n = delta.unsigned_abs();
+        if body < 2 || n == 0 || n >= body {
+            return Action::Redraw;
+        }
+
+        let mut out = String::new();
+        out.push_str(&terminal::set_scroll_region(1, body as u16));
+        let (first_row, first_doc) = if delta > 0 {
+            // scrolled forward: body moves up, new lines appear at the bottom
+            out.push_str(&terminal::scroll_up(n as u16));
+            (body - n + 1, self.offset + body - n)
+        } else {
+            // scrolled back: body moves down, new lines appear at the top
+            out.push_str(&terminal::scroll_down(n as u16));
+            (1, self.offset)
+        };
+        for i in 0..n {
+            out.push_str(&format!("{}", terminal::Goto(1, (first_row + i) as u16)));
+            if let Some(line) = self.line(first_doc + i) {
+                out.push_str(&self.render_menu_line(&line));
+            } else {
+                out.push_str(terminal::ClearUntilNewline.as_ref());
+            }
+        }
+        out.push_str(terminal::reset_scroll_region());
+
+        // The selection cursor (`*`) is baked into the body text, so the
+        // terminal scroll carries it along with its line. If the selected
+        // link changed during this scroll, erase the old `*` and draw the
+        // new one; both are no-ops when the link isn't on screen.
+        if old_link != self.link {
+            if let Some(s) = self.clear_cursor(old_link) {
+                out.push_str(&s);
+            }
+        }
+        if let Some(s) = self.draw_cursor() {
+            out.push_str(&s);
+        }
+
+        Action::Draw(out)
+    }
